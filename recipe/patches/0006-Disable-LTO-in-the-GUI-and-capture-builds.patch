Subject: [PATCH] Disable LTO in the GUI and capture builds

Link-time optimization increases linking time by several minutes without a
noticeable runtime speedup for our use case, so disable it.

diff --git a/cmake/config.cmake b/cmake/config.cmake
--- a/cmake/config.cmake
+++ b/cmake/config.cmake
@@ -44,7 +44,7 @@
 endif()
 
 if(NOT CMAKE_BUILD_TYPE STREQUAL "Debug" AND NOT EMSCRIPTEN)
-    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION ON)
+    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION OFF)
 endif()
 
 if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
